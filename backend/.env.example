PORT=5000

# MySQL (optional — falls back to SQLite if unreachable)
# Set DISABLE_MYSQL=1 to always skip MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=trading
DB_PASSWORD=trading
DB_NAME=trading

# SQLite fallback store (used when MySQL is unavailable). ':memory:' for ephemeral.
SQLITE_PATH=./data/trading.db

JWT_SECRET=supersecret-change-me
JWT_EXPIRES=7d
APP_URL=http://localhost:5173

# Redis (optional — in-memory bus used when unset)
REDIS_URL=redis://localhost:6379

# Engine: run as an external worker process (npm run engine). Leave unset for inline.
ENGINE_EXTERNAL=1
ENGINE_INTERVAL_MS=15000
LIVE_BARS_PER_TICK=25

# Broker credential encryption key (AES-256-GCM). Keep secret in production.
BROKER_ENC_KEY=dev-broker-enc-key-do-not-use

# External market data providers (optional — synthetic data used when unset)
MARKET_DATA_API_KEY=
MARKET_DATA_API_BASE=https://api.twelvedata.com
BINANCE_API_BASE=https://api.binance.com

# FastAPI AI service
AI_SERVICE_URL=http://localhost:8000
