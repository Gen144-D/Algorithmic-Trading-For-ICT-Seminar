PORT=5000

# MySQL (optional — falls back to in-memory DB if unreachable)
DB_HOST=localhost
DB_PORT=3306
DB_USER=trading
DB_PASSWORD=trading
DB_NAME=trading

JWT_SECRET=supersecret-change-me
JWT_EXPIRES=7d

# External market data provider (optional — synthetic data used when unset)
MARKET_DATA_API_KEY=
MARKET_DATA_API_BASE=https://api.twelvedata.com

# FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Demo: how many live bars the engine advances per tick, and how often
LIVE_BARS_PER_TICK=25
ENGINE_INTERVAL_MS=15000
